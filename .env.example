# Intron Sahara v2.5 STT configuration.
# Obtain the API key from https://voice.intron.io -> Developer.
SAHARA_API_KEY=
SAHARA_API_URL=https://infer.voice.intron.io/file/v1/upload/sync
SAHARA_LANGUAGE=sw
SAHARA_DISABLE_LLM_CORRECTIONS=TRUE
SAHARA_RESPONSE_TEXT_PATH=data.audio_transcript
SAHARA_TIMEOUT_SECONDS=120
SAHARA_FORM_JSON={}

# Whisper configuration selected from the 10-clip development pilot.
WHISPER_MODEL=turbo
WHISPER_LANGUAGE=sw
WHISPER_TEMPERATURE=0

# MMS uses the model's Swahili adapter code.
MMS_TARGET_LANG=swh

# Meta Omnilingual ASR lightweight CTC benchmark default.
OMNIASR_MODEL_CARD=omniASR_CTC_300M_v2

# Optional generic HTTP backend for experiments outside the four-model matrix.
ASR_HTTP_URL=
ASR_HTTP_KEY=
ASR_HTTP_FILE_FIELD=file
ASR_HTTP_TEXT_FIELD=text
